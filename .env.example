# Copy to .env and fill in. Never commit .env.

# --- EcoFlow Developer Platform ---
# Keys from https://developer.ecoflow.com (verify host for your region)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# Leave empty to show the fake data from `npm run seed:fake` (device FAKE-DEVICE)
ECOFLOW_DEVICE_SN=
ECOFLOW_API_HOST=https://api-e.ecoflow.com

# --- Poller ---
POLL_INTERVAL_MS=300000

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=ecoboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecoboard
POSTGRES_PORT=5432

# --- App ---
DATABASE_URL=postgres://ecoboard:change-me@localhost:5432/ecoboard
PORT=3000

# Startup: how many times to try connecting to the database,
# and how long to wait between tries (milliseconds)
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_DELAY_MS=3000
